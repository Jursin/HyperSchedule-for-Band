<script>
import interconnect from "@system.interconnect"

const preferences = require("./common/preferences.js")
const utils = require("./common/utils.js")

const conn = interconnect.instance()

export default {
  onCreate() {
    // 启动时预载偏好，避免页面首帧显示默认主题色
    preferences.getPreferences()
    // 消息统一在这里接收，页面销毁或还没初始化时也不会丢
    conn.onmessage = (event) => this.onScheduleMessage(event)
  },

  onScheduleMessage(event) {
    let imported = null
    try {
      imported = utils.tryExtractSchedule(event && event.data)
    } catch (err) {
      imported = null
    }
    if (!imported) {
      utils.showToast("导入失败，数据格式不正确")
      return
    }
    this.saveImported(imported)
  },

  saveImported(imported) {
    utils.saveSchedule(imported, (ok, schedule) => {
      if (!ok) {
        utils.showToast("导入失败，保存异常")
        return
      }
      utils.showToast("已导入 " + schedule.courses.length + " 门课程")
      // 首页在 onInit 里注册，用来即时刷新界面
      const handler = this.$def && this.$def.onScheduleImported
      if (typeof handler === "function") {
        handler(schedule)
      }
    })
  }
}
</script>
