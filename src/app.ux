<script>
import interconnect from "@system.interconnect"
import device from "@system.device"
import app from "@system.app"

const preferences = require("./common/preferences.js")
const utils = require("./common/utils.js")

const conn = interconnect.instance()

// 互联消息负载：字符串按 JSON 解析，对象直接用
function parsePayload(raw) {
  if (typeof raw === "string") {
    try {
      return JSON.parse(raw)
    } catch (err) {
      return null
    }
  }
  return raw && typeof raw === "object" ? raw : null
}

export default {
  onCreate() {
    // 启动时预载偏好，避免页面首帧显示默认主题色
    preferences.getPreferences()
    // 消息统一在这里接收，页面销毁或还没初始化时也不会丢
    conn.onmessage = (event) => this.onMessage(event)
  },

  onMessage(event) {
    const payload = parsePayload(event && event.data)
    // 手机查设备信息的回传，其余按课表导入处理
    if (payload && payload.type === "query_device") {
      this.replyDeviceInfo()
      return
    }
    let imported = null
    try {
      imported = utils.tryExtractSchedule(payload)
    } catch (err) {
      imported = null
    }
    if (!imported) {
      utils.showToast("导入失败：数据格式不正确")
      return
    }
    this.saveImported(imported)
  },

  replyDeviceInfo() {
    let appInfo = {}
    try {
      appInfo = app.getInfo() || {}
    } catch (err) {
      appInfo = {}
    }
    const send = (info) => {
      const d = info || {}
      conn.send({
        data: {
          type: "device_info",
          deviceType: d.deviceType || "",
          screenShape: d.screenShape || "",
          versionName: appInfo.versionName || "",
          versionCode: appInfo.versionCode || 0
        },
        fail: () => {}
      })
    }
    device.getInfo({success: send, fail: () => send(null)})
  },

  saveImported(imported) {
    utils.saveSchedule(imported, (ok, schedule) => {
      if (!ok) {
        utils.showToast("导入失败：保存异常")
        return
      }
      const names = schedule.courses.map((item) => item.name)
      const count = names.filter((name, index) => names.indexOf(name) === index).length
      utils.showToast("已导入" + count + "门课程")
      // 首页在 onInit 里注册，用来即时刷新界面
      const handler = this.$def && this.$def.onScheduleImported
      if (typeof handler === "function") {
        handler(schedule)
      }
    })
  }
}
</script>
