<template>
  <div class="page">
    <scroll class="page-scroll" scroll-y="true" bounces="true">
      <div class="time-section">
        <text class="current-time">{{ currentTime }}</text>
      </div>
      <div class="course-section">
        <text class="course-name">{{ course.name }}</text>
        <text class="course-meta" style="color: {{ themeColor }}" if="{{ course.timeText }}">
          {{ course.timeText }}
        </text>
        <text class="course-meta" if="{{ course.position }}">{{ course.position }}</text>
        <text class="course-meta" if="{{ course.teacher }}">{{ course.teacher }}</text>
        <text
          class="remaining-time"
          style="color: {{ themeColor }}"
          if="{{ showUpcomingReminder }}"
        >
          {{ upcomingText }}上课
        </text>
        <progress
          class="course-progress"
          style="color: {{ themeColor }}"
          if="{{ showUpcomingReminder }}"
          percent="{{ upcomingProgressPercent }}"
          type="horizontal"
        ></progress>
        <text class="remaining-time" style="color: {{ themeColor }}" if="{{ course.isOngoing }}">
          {{ remainingText }}下课
        </text>
        <progress
          class="course-progress"
          style="color: {{ themeColor }}"
          if="{{ course.isOngoing }}"
          percent="{{ course.progressPercent }}"
          type="horizontal"
        ></progress>
      </div>
      <div class="next-course-section" if="{{ nextCourse.name }}">
        <text class="next-course-label">下一节</text>
        <text class="next-course-name">{{ nextCourse.name }}</text>
        <text class="next-course-meta" if="{{ nextCourse.position }}">
          {{ nextCourse.position }}
        </text>
      </div>
      <div class="remark-section" if="{{ !hideRemark && course.remark }}">
        <text class="remark-text">{{ course.remark }}</text>
      </div>
    </scroll>
  </div>
</template>

<script>
const preferences = require("../../common/preferences.js")
const utils = require("../../common/utils.js")

// 剩余时长按分钟向上取整，不足一分钟也显示 1，满一小时才带小时
function remainingLabel(remainingSeconds) {
  const minutes = Math.max(Math.ceil(remainingSeconds / 60), 1)
  const hours = Math.floor(minutes / 60)
  if (hours === 0) {
    return "还剩" + minutes + "分钟"
  }
  if (minutes % 60 === 0) {
    return "还剩" + hours + "小时"
  }
  return "还剩" + hours + "小时" + (minutes % 60) + "分钟"
}

export default {
  protected: {
    course: {
      name: "",
      timeText: "",
      position: "",
      teacher: "",
      remark: "",
      range: null,
      isOngoing: false,
      progressPercent: 0
    },
    todayCourses: [],
    preClassMinutes: "",
    dayOffset: 0
  },

  private: {
    currentTime: "",
    themeColor: preferences.getCachedThemeColor(),
    hideRemark: false,
    remainingText: "",
    upcomingText: "",
    upcomingWindowMinutes: 0,
    showUpcomingReminder: false,
    upcomingProgressPercent: 0,
    nextCourse: {
      name: "",
      position: ""
    },
    sortedTodayCourses: [],
    timer: null
  },

  onInit() {
    // 解析参数
    try {
      const courseData = typeof this.course === "string" ? JSON.parse(this.course) : this.course
      this.course = courseData
      if (this.todayCourses) {
        this.todayCourses =
          typeof this.todayCourses === "string" ? JSON.parse(this.todayCourses) : this.todayCourses
      }
    } catch (e) {
      console.error("Failed to parse params:", e)
    }
    this.upcomingWindowMinutes = utils.normalizePreClassMinutes(this.preClassMinutes)
    const offset = Number(this.dayOffset)
    this.dayOffset = Number.isNaN(offset) ? 0 : offset
    this.initTodayCourseIndex()
    this.calculateRemainingTime()
    this.calculateUpcomingReminder()
    this.calculateNextCourse()
    this.updateCurrentTime()
    this.loadPreference()
    this.startDetailTimer()
  },

  startDetailTimer() {
    this.timer = setInterval(() => {
      this.updateCurrentTime()
      this.calculateRemainingTime()
      this.calculateUpcomingReminder()
      this.calculateNextCourse()
    }, 1000)
  },

  // 当天课程按开始时间排序，区间由首页算好随参数带过来
  initTodayCourseIndex() {
    const courses = Array.isArray(this.todayCourses) ? this.todayCourses : []
    this.sortedTodayCourses = courses.slice().sort((a, b) => {
      const t1 = a.range ? a.range.start : 0
      const t2 = b.range ? b.range.start : 0
      return t1 - t2
    })
  },

  loadPreference() {
    preferences.getPreferences((pref) => {
      this.themeColor = pref.themeColor
      this.hideRemark = pref.hideRemark === true
    })
  },

  // 上课时底部显示下一节课课程名和地点
  calculateNextCourse() {
    let next = null
    if (this.course.isOngoing && this.course.range) {
      for (let i = 0; i < this.sortedTodayCourses.length; i += 1) {
        const item = this.sortedTodayCourses[i]
        if (item.range && item.range.start > this.course.range.end) {
          next = item
          break
        }
      }
    }
    const name = next ? next.name || "" : ""
    const position = next ? next.position || "" : ""
    // 仅在值变化时更新，避免每秒触发渲染
    if (this.nextCourse.name !== name || this.nextCourse.position !== position) {
      this.nextCourse.name = name
      this.nextCourse.position = position
    }
  },

  stopDetailTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  onDestroy() {
    this.stopDetailTimer()
  },

  onHide() {
    this.stopDetailTimer()
  },

  onShow() {
    this.updateCurrentTime()
    if (!this.timer) {
      this.startDetailTimer()
    }
  },

  updateCurrentTime() {
    const now = new Date()
    const hh = utils.pad2(now.getHours())
    const mm = utils.pad2(now.getMinutes())
    const ss = utils.pad2(now.getSeconds())
    this.currentTime = hh + ":" + mm + ":" + ss
  },

  calculateRemainingTime() {
    const range = this.course.range
    if (!range) return
    if (this.dayOffset !== 0) {
      this.course.isOngoing = false
      this.course.progressPercent = 0
      this.remainingText = ""
      return
    }

    const now = new Date()
    const totalStartSeconds = range.start * 60
    const totalEndSeconds = range.end * 60
    const totalCurrentSeconds = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds()

    // 尚未到上课时间
    if (totalCurrentSeconds < totalStartSeconds) {
      this.course.isOngoing = false
      this.course.progressPercent = 0
      this.remainingText = ""
      return
    }

    // 已过下课时间
    const remainingSeconds = totalEndSeconds - totalCurrentSeconds
    if (remainingSeconds <= 0) {
      this.remainingText = ""
      this.course.isOngoing = false
      this.course.progressPercent = 100
      return
    }

    // 正在上课中
    this.course.isOngoing = true
    this.remainingText = remainingLabel(remainingSeconds)
    const durationSeconds = totalEndSeconds - totalStartSeconds
    if (durationSeconds > 0) {
      this.course.progressPercent = Math.floor(
        ((totalCurrentSeconds - totalStartSeconds) * 100) / durationSeconds
      )
    }
  },

  // 上课提醒和进度条：仅在本节课开课前的提前量窗口内显示，提前量为 0 时不显示
  calculateUpcomingReminder() {
    const range = this.course.range
    const windowMinutes = this.upcomingWindowMinutes
    if (!range || windowMinutes <= 0 || this.dayOffset !== 0) {
      this.showUpcomingReminder = false
      return
    }
    const from = range.start - windowMinutes
    const now = new Date()
    const currentSeconds = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds()
    const currentMinutes = Math.floor(currentSeconds / 60)
    const show = from >= 0 && currentMinutes >= from && currentMinutes < range.start
    this.showUpcomingReminder = show
    if (!show) {
      return
    }
    const startSeconds = range.start * 60
    const fromSeconds = from * 60
    this.upcomingText = remainingLabel(startSeconds - currentSeconds)
    this.upcomingProgressPercent = Math.floor(
      ((currentSeconds - fromSeconds) * 100) / (startSeconds - fromSeconds)
    )
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.page-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: 60px 10px;
}

.time-section {
  margin-bottom: 16px;
}

.current-time {
  color: #ffffff;
  font-size: 38px;
  font-weight: 700;
}

.course-section {
  flex-direction: column;
  width: 100%;
  align-items: center;
}

.next-course-section {
  flex-direction: column;
  width: 100%;
  align-items: center;
  padding-top: 24px;
}

.next-course-label {
  color: #999999;
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 6px;
  text-align: center;
}

.next-course-name {
  color: #ffffff;
  font-size: 26px;
  font-weight: 700;
  margin-bottom: 2px;
  text-align: center;
}

.next-course-meta {
  color: #cccccc;
  font-size: 22px;
  font-weight: 700;
  text-align: center;
}

.course-name {
  color: #ffffff;
  font-size: 30px;
  font-weight: 700;
  margin-bottom: 16px;
  text-align: center;
}

.course-meta {
  color: #cccccc;
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 4px;
  text-align: center;
}

.remark-section {
  flex-direction: column;
  width: 100%;
  align-items: center;
  padding-top: 24px;
}

.remark-text {
  color: #cccccc;
  font-size: 22px;
  font-weight: 700;
  line-height: 30px;
  text-align: center;
}

.remaining-time {
  font-size: 23px;
  font-weight: 700;
  margin: 14px 0;
  text-align: center;
}

.course-progress {
  width: 100%;
  margin-top: 10px;
  stroke-width: 10px;
  layer-color: rgba(255, 255, 255, 0.2);
}

@media (shape: rect) {
  .page-scroll {
    padding: 45px 10px;
  }

  .current-time {
    font-size: 60px;
  }

  .course-name {
    font-size: 34px;
  }

  .course-meta {
    font-size: 32px;
  }

  .next-course-label {
    font-size: 22px;
  }

  .next-course-name {
    font-size: 28px;
  }

  .next-course-meta {
    font-size: 24px;
  }

  .remark-text {
    font-size: 24px;
    line-height: 32px;
  }
}
</style>
