<template>
  <div class="page">
    <scroll class="page-scroll" scroll-y="true" bounces="true">
      <div class="time-section">
        <text class="current-time">{{ currentTime }}</text>
      </div>
      <div class="course-section">
        <text class="course-name">{{ course.name }}</text>
        <text class="course-meta" if="{{ course.timeText }}">{{ course.timeText }}</text>
        <text class="course-meta" if="{{ course.position }}">{{ course.position }}</text>
        <text class="course-meta" if="{{ course.teacher }}">{{ course.teacher }}</text>
        <text
          class="remaining-time"
          style="color: {{ themeColor }}"
          if="{{ showUpcomingReminder }}"
        >
          还剩{{ upcomingMinutes }}分钟上课
        </text>
        <progress
          class="course-progress"
          style="color: {{ themeColor }}"
          if="{{ showUpcomingReminder }}"
          percent="{{ upcomingProgressPercent }}"
          type="horizontal"
        ></progress>
        <text class="remaining-time" style="color: {{ themeColor }}" if="{{ course.isOngoing }}">
          还剩{{ remainingMinutes }}分钟下课
        </text>
        <progress
          class="course-progress"
          style="color: {{ themeColor }}"
          if="{{ course.isOngoing }}"
          percent="{{ course.progressPercent }}"
          type="horizontal"
        ></progress>
      </div>
      <div class="next-course-section" if="{{ nextCourse.name }}">
        <text class="next-course-label">下一节</text>
        <text class="next-course-name">{{ nextCourse.name }}</text>
        <text class="next-course-meta" if="{{ nextCourse.position }}">
          {{ nextCourse.position }}
        </text>
      </div>
    </scroll>
  </div>
</template>

<script>
const preferences = require("../../common/preferences.js")
const utils = require("../../common/utils.js")

// 仅在上课前 30 分钟内显示倒计时
const UPCOMING_REMINDER_MINUTES = 30

export default {
  protected: {
    course: {
      name: "",
      timeText: "",
      position: "",
      teacher: "",
      range: null,
      isOngoing: false,
      progressPercent: 0
    },
    todayCourses: []
  },

  private: {
    currentTime: "",
    themeColor: preferences.getCachedThemeColor(),
    remainingMinutes: 0,
    upcomingMinutes: 0,
    showUpcomingReminder: false,
    upcomingProgressPercent: 0,
    nextCourse: {
      name: "",
      position: ""
    },
    sortedTodayCourses: [],
    timer: null
  },

  onInit() {
    // 解析参数
    try {
      const courseData = typeof this.course === "string" ? JSON.parse(this.course) : this.course
      this.course = courseData
      if (this.todayCourses) {
        this.todayCourses =
          typeof this.todayCourses === "string" ? JSON.parse(this.todayCourses) : this.todayCourses
      }
    } catch (e) {
      console.error("Failed to parse params:", e)
    }
    this.initTodayCourseIndex()
    this.calculateRemainingTime()
    this.calculateUpcomingReminder()
    this.calculateNextCourse()
    this.updateCurrentTime()
    this.loadPreference()
    this.startDetailTimer()
  },

  startDetailTimer() {
    this.timer = setInterval(() => {
      this.updateCurrentTime()
      this.calculateRemainingTime()
      this.calculateUpcomingReminder()
      if (this.course.isOngoing) {
        this.calculateNextCourse()
      }
    }, 1000)
  },

  // 当天课程按开始时间排序，区间由首页算好随参数带过来
  initTodayCourseIndex() {
    const courses = Array.isArray(this.todayCourses) ? this.todayCourses : []
    this.sortedTodayCourses = courses.slice().sort((a, b) => {
      const t1 = a.range ? a.range.start : 0
      const t2 = b.range ? b.range.start : 0
      return t1 - t2
    })
  },

  loadPreference() {
    preferences.getPreferences((pref) => {
      this.themeColor = pref.themeColor
    })
  },

  courseMatchKey(course) {
    if (!course || typeof course !== "object") {
      return ""
    }
    return (course.name || "") + "|" + (course.timeText || "")
  },

  // 上课时底部显示下一节课课程名和教室
  calculateNextCourse() {
    let next = null
    if (this.course.isOngoing && this.course.range) {
      for (let i = 0; i < this.sortedTodayCourses.length; i += 1) {
        const item = this.sortedTodayCourses[i]
        if (item.range && item.range.start > this.course.range.end) {
          next = item
          break
        }
      }
    }
    const name = next ? next.name || "" : ""
    const position = next ? next.position || "" : ""
    // 仅在值变化时更新，避免每秒触发渲染
    if (this.nextCourse.name !== name || this.nextCourse.position !== position) {
      this.nextCourse.name = name
      this.nextCourse.position = position
    }
  },

  stopDetailTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  onDestroy() {
    this.stopDetailTimer()
  },

  onHide() {
    this.stopDetailTimer()
  },

  onShow() {
    this.updateCurrentTime()
    if (!this.timer) {
      this.startDetailTimer()
    }
  },

  updateCurrentTime() {
    const now = new Date()
    const hh = utils.pad2(now.getHours())
    const mm = utils.pad2(now.getMinutes())
    const ss = utils.pad2(now.getSeconds())
    this.currentTime = hh + ":" + mm + ":" + ss
  },

  calculateRemainingTime() {
    const range = this.course.range
    if (!range) return

    const now = new Date()
    const totalStartSeconds = range.start * 60
    const totalEndSeconds = range.end * 60
    const totalCurrentSeconds = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds()

    // 尚未到上课时间
    if (totalCurrentSeconds < totalStartSeconds) {
      this.course.isOngoing = false
      this.course.progressPercent = 0
      this.remainingMinutes = 0
      return
    }

    // 已过下课时间
    const remainingSeconds = totalEndSeconds - totalCurrentSeconds
    if (remainingSeconds <= 0) {
      this.remainingMinutes = 0
      this.course.isOngoing = false
      this.course.progressPercent = 100
      return
    }

    // 正在上课中
    this.course.isOngoing = true
    this.remainingMinutes = Math.ceil(remainingSeconds / 60)
    const durationSeconds = totalEndSeconds - totalStartSeconds
    if (durationSeconds > 0) {
      this.course.progressPercent = Math.floor(
        ((totalCurrentSeconds - totalStartSeconds) * 100) / durationSeconds
      )
    }
  },

  // 上课提醒和进度条：仅在本节课开课前 30 分钟内显示
  calculateUpcomingReminder() {
    const range = this.course.range
    if (!range) {
      this.showUpcomingReminder = false
      return
    }
    const key = this.courseMatchKey(this.course)
    let from = -1
    for (let i = 0; i < this.sortedTodayCourses.length; i += 1) {
      const item = this.sortedTodayCourses[i]
      if (!item.range || this.courseMatchKey(item) !== key) {
        continue
      }
      const prevRange = i > 0 ? this.sortedTodayCourses[i - 1].range : null
      const prevEnd = prevRange ? prevRange.end : range.start - UPCOMING_REMINDER_MINUTES
      from = Math.max(prevEnd, range.start - UPCOMING_REMINDER_MINUTES)
      break
    }
    const currentMinutes = utils.minutesOfDay()
    const show = from >= 0 && currentMinutes >= from && currentMinutes < range.start
    this.showUpcomingReminder = show
    if (!show) {
      return
    }
    this.upcomingMinutes = range.start - currentMinutes
    this.upcomingProgressPercent = Math.floor(
      ((currentMinutes - from) * 100) / (range.start - from)
    )
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.page-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: 60px 10px;
}

.time-section {
  margin-bottom: 16px;
}

.current-time {
  color: #ffffff;
  font-size: 38px;
  font-weight: 700;
}

.course-section {
  flex-direction: column;
  width: 100%;
  align-items: center;
}

.next-course-section {
  flex-direction: column;
  width: 100%;
  align-items: center;
  padding-top: 24px;
}

.next-course-label {
  color: #999999;
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 6px;
  text-align: center;
}

.next-course-name {
  color: #ffffff;
  font-size: 26px;
  font-weight: 700;
  margin-bottom: 2px;
  text-align: center;
}

.next-course-meta {
  color: #cccccc;
  font-size: 22px;
  font-weight: 700;
  text-align: center;
}

.course-name {
  color: #ffffff;
  font-size: 30px;
  font-weight: 700;
  margin-bottom: 16px;
  text-align: center;
}

.course-meta {
  color: #cccccc;
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 4px;
  text-align: center;
}

.remaining-time {
  color: #237bff;
  font-size: 23px;
  font-weight: 700;
  margin: 14px 0;
  text-align: center;
}

.course-progress {
  width: 100%;
  margin-top: 10px;
  stroke-width: 10px;
  color: #237bff;
  layer-color: rgba(255, 255, 255, 0.2);
}

@media (shape: rect) {
  .page-scroll {
    padding: 45px 10px;
  }

  .current-time {
    font-size: 60px;
  }

  .course-name {
    font-size: 34px;
  }

  .course-meta {
    font-size: 32px;
  }

  .next-course-label {
    font-size: 22px;
  }

  .next-course-name {
    font-size: 28px;
  }

  .next-course-meta {
    font-size: 24px;
  }
}
</style>
