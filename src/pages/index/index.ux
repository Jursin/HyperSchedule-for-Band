<template>
  <div class="page">
    <text class="pill-time">{{ currentTime }}</text>
    <div class="header-wrap">
      <text class="week-text">第{{ currentWeekText }}周</text>
      <text class="rect-time">{{ currentTime }}</text>
      <div class="date-switch-row">
        <div class="date-arrow-button" onclick="goPrevDay">
          <image class="date-arrow-icon" src="/common/left.png"></image>
        </div>
        <div class="date-center-wrap" onclick="goToday">
          <div class="date-row">
            <text class="day-text">{{ selectedDayText }}</text>
            <text class="date-text">{{ selectedDateText }}</text>
          </div>
        </div>
        <div class="date-arrow-button" onclick="goNextDay">
          <image class="date-arrow-icon" src="/common/right.png"></image>
        </div>
      </div>
    </div>

    <div class="course-content">
      <scroll class="course-list-scroll" scroll-y="true" bounces="true" if="{{ !notStarted && hasCourses }}">
        <block for="{{ group in courseGroups }}">
          <block if="{{ group.courses.length > 0 }}">
            <text class="section-title">{{ group.title }}</text>
            <block for="{{ course in group.courses }}">
              <div class="course-row">
                <div
                  class="course-card {{ centerHomeText ? 'course-card-centered' : '' }}"
                  style="{{ course.isOngoing ? 'background-color:' + themeColor : '' }}"
                  onclick="openCourseDetail(course)"
                >
                  <text class="course-name {{ centerHomeText ? 'text-centered' : '' }}">
                    {{ course.name }}
                  </text>
                  <text class="course-meta {{ centerHomeText ? 'text-centered' : '' }}" if="{{ course.timeText }}">
                    {{ course.timeText }}
                  </text>
                  <text
                    class="course-meta {{ centerHomeText ? 'text-centered' : '' }}"
                    if="{{ course.position }}"
                  >
                    {{ course.position }}
                  </text>
                  <text
                    class="course-meta {{ centerHomeText ? 'text-centered' : '' }}"
                    if="{{ course.teacher }}"
                  >
                    {{ course.teacher }}
                  </text>
                  <progress
                    class="course-progress"
                    if="{{ course.isOngoing }}"
                    percent="{{ course.progressPercent }}"
                    type="horizontal"
                  ></progress>
                </div>
              </div>
            </block>
          </block>
        </block>
      </scroll>

      <div
        class="state-wrap"
        if="{{ semesterStartDateMissing || semesterTotalWeeksMissing || notStarted || !hasCourses }}"
      >
        <image class="empty-icon" src="/common/rest.png"></image>
        <text class="empty-text">
          {{
            semesterStartDateMissing
              ? "请先设置开学日期"
              : semesterTotalWeeksMissing
                ? "请先设置学期周数"
                : notStarted
                  ? "暂未开学"
                  : semesterEnded
                    ? "学期已结束"
                    : "今日无课程"
          }}
        </text>
      </div>
    </div>

    <div class="settings-button" onclick="openSettings">
      <image class="settings-icon" src="/common/more.png"></image>
    </div>
  </div>
</template>

<script>
import router from "@system.router"

const preferences = require("../../common/preferences.js")
const utils = require("../../common/utils.js")
// 左右切换日期的上限
const DAY_OFFSET_MAX = 180

function formatDate(date) {
  const y = date.getFullYear()
  const m = (date.getMonth() + 1 + "").padStart(2, "0")
  const d = (date.getDate() + "").padStart(2, "0")
  return y + "-" + m + "-" + d
}

// 周次以周一为界
function mondayOf(date) {
  const monday = new Date(formatDate(date) + "T00:00:00")
  monday.setDate(monday.getDate() - ((monday.getDay() + 6) % 7))
  return monday
}

function weekFromStart(startDate, targetDate) {
  if (!startDate) {
    return 0
  }
  const start = mondayOf(new Date(startDate + "T00:00:00"))
  if (isNaN(start.getTime())) {
    return 0
  }
  const target = mondayOf(targetDate instanceof Date ? targetDate : new Date())
  const diffDays = Math.floor((target.getTime() - start.getTime()) / 86400000)
  if (diffDays < 0) {
    return -1
  }
  return Math.floor(diffDays / 7) + 1
}

function dayText(day) {
  return ["", "周一", "周二", "周三", "周四", "周五", "周六", "周日"][day] || "周一"
}

function addDays(date, offsetDays) {
  const next = new Date(formatDate(date) + "T00:00:00")
  next.setDate(next.getDate() + offsetDays)
  return next
}

function dayOfWeekFromDate(date) {
  const day = date.getDay()
  return day === 0 ? 7 : day
}

function formatMonthDay(date) {
  const m = (date.getMonth() + 1 + "").padStart(2, "0")
  const d = (date.getDate() + "").padStart(2, "0")
  return m + "-" + d
}

function minutesToText(minutes) {
  return utils.pad2(Math.floor(minutes / 60)) + ":" + utils.pad2(minutes % 60)
}

function timeRange(startText, endText) {
  const start = utils.timeToMinutes(startText)
  const end = utils.timeToMinutes(endText)
  if (start === null || end === null) {
    return null
  }
  return {start, end}
}

// 自定义时间优先，否则取起止节次的作息时间
function resolveCourseRangeMinutes(item, startSlot, endSlot) {
  if (item.isCustomTime === true && item.customStartTime && item.customEndTime) {
    return timeRange(item.customStartTime, item.customEndTime)
  }
  if (startSlot && endSlot) {
    return timeRange(startSlot.startTime, endSlot.endTime)
  }
  return null
}

// 按当前时刻刷新「进行中」与进度，值没变就不写，避免无谓渲染
function applyTimeState(course, minutes, isToday) {
  const range = course.range
  const hasRange = !!range && range.end > range.start
  let ongoing = false
  let percent = 0
  if (isToday && hasRange) {
    ongoing = minutes >= range.start && minutes <= range.end
    if (minutes <= range.start) {
      percent = 0
    } else if (minutes >= range.end) {
      percent = 100
    } else {
      percent = Math.floor(((minutes - range.start) * 100) / (range.end - range.start))
    }
  }
  if (course.isOngoing !== ongoing) {
    course.isOngoing = ongoing
  }
  if (course.progressPercent !== percent) {
    course.progressPercent = percent
  }
}

export default {
  private: {
    scheduleData: utils.createEmptySchedule(),
    selectedDay: dayOfWeekFromDate(new Date()),
    selectedDayText: dayText(dayOfWeekFromDate(new Date())),
    selectedDateText: formatMonthDay(new Date()),
    selectedOffsetDays: 0,
    displayCourses: [],
    hasCourses: false,
    notStarted: false,
    semesterEnded: false,
    semesterStartDateMissing: false,
    semesterTotalWeeksMissing: false,
    currentWeek: 0,
    currentWeekText: "-",
    hideTeacher: false,
    centerHomeText: false,
    prefixAtSymbol: false,
    themeColor: preferences.getCachedThemeColor(),
    courseGroups: [],
    currentTime: "",
    todayDate: formatDate(new Date()),
    timerId: 0
  },

  onInit() {
    this.startTicking()
    this.bindImportRefresh()
    this.loadSchedule()
  },

  onDestroy() {
    utils.stopClock(this)
    this.$app.$def.onScheduleImported = null
  },

  onHide() {
    utils.stopClock(this)
  },

  onShow() {
    this.startTicking()
    this.loadSchedule()
  },

  startTicking() {
    utils.startClock(this, () => this.onClockTick())
  },

  // 亮屏常看时也要让进度条动起来，跨天则整页重算
  onClockTick() {
    if (formatDate(new Date()) !== this.todayDate) {
      this.afterLoad()
      return
    }
    if (this.selectedOffsetDays !== 0) {
      return
    }
    const courses = this.displayCourses
    const minutes = utils.minutesOfDay()
    for (let i = 0; i < courses.length; i += 1) {
      applyTimeState(courses[i], minutes, true)
    }
  },

  // 左右箭头按天翻，点日期回到今天
  goPrevDay() {
    this.selectOffsetDays(this.selectedOffsetDays - 1)
  },

  goNextDay() {
    this.selectOffsetDays(this.selectedOffsetDays + 1)
  },

  goToday() {
    this.selectOffsetDays(0)
  },

  selectOffsetDays(offset) {
    this.selectedOffsetDays = Math.max(-DAY_OFFSET_MAX, Math.min(DAY_OFFSET_MAX, offset))
    this.afterLoad()
  },

  openSettings() {
    router.push({
      uri: "/pages/settings"
    })
  },

  // app.ux 收到推送后回调这里，刷新界面并回到今天
  bindImportRefresh() {
    this.$app.$def.onScheduleImported = (schedule) => {
      this.scheduleData = schedule
      this.selectOffsetDays(0)
    }
  },

  loadSchedule() {
    // 先加载偏好设置，再加载课表，避免首屏闪现老师名
    this.loadPreferences(() => {
      // 开发/调试时直接使用示例课表，生产版本走本地存储
      if (process.env.NODE_ENV !== "production") {
        this.applySchedule(require("../../../examples/example-schedule.json"))
        return
      }
      utils.readSchedule((data) => this.applySchedule(data))
    })
  },

  applySchedule(data) {
    this.scheduleData = utils.normalizeScheduleData(data)
    this.afterLoad()
  },

  loadPreferences(callback) {
    preferences.getPreferences((pref) => {
      this.hideTeacher = !!pref.hideTeacher
      this.centerHomeText = !!pref.centerHomeText
      this.prefixAtSymbol = !!pref.prefixAtSymbol
      this.themeColor = pref.themeColor
      if (callback) {
        callback()
      }
    })
  },

  afterLoad() {
    const config = this.scheduleData.config
    this.todayDate = formatDate(new Date())
    const selectedDate = addDays(new Date(), this.selectedOffsetDays)
    this.selectedDateText = formatMonthDay(selectedDate)
    this.selectedDay = dayOfWeekFromDate(selectedDate)
    this.selectedDayText = dayText(this.selectedDay)

    // 手机端没设开学日期时不推该字段
    const semesterTotalWeeks = Number(config.semesterTotalWeeks)
    this.semesterStartDateMissing = !config.semesterStartDate
    this.semesterTotalWeeksMissing = !this.semesterStartDateMissing && !(semesterTotalWeeks > 0)
    this.notStarted = false
    this.semesterEnded = false
    this.currentWeek = 0
    this.currentWeekText = "-"
    if (this.semesterStartDateMissing || this.semesterTotalWeeksMissing) {
      this.displayCourses = []
      this.courseGroups = []
      this.hasCourses = false
      return
    }

    // 以配置的学期周数为学期结束依据
    this.currentWeek = weekFromStart(config.semesterStartDate, selectedDate)
    this.notStarted = this.currentWeek < 0
    this.semesterEnded = this.currentWeek > semesterTotalWeeks
    this.currentWeekText = this.notStarted ? "-" : String(this.currentWeek)
    this.refreshCourses()
  },

  refreshCourses() {
    const slotMap = {}
    const timeSlots = this.scheduleData.timeSlots
    for (let i = 0; i < timeSlots.length; i += 1) {
      slotMap[timeSlots[i].number] = timeSlots[i]
    }
    const isToday = this.selectedOffsetDays === 0
    const minutes = utils.minutesOfDay()
    const target = []
    const courses = this.scheduleData.courses
    for (let i = 0; i < courses.length; i += 1) {
      const item = courses[i]
      // 周次缺失或本周没有这门课
      if (item.day !== this.selectedDay || (item.weeks || []).indexOf(this.currentWeek) < 0) {
        continue
      }
      const range = resolveCourseRangeMinutes(
        item,
        slotMap[item.startSection],
        slotMap[item.endSection]
      )
      // 手机端推送前已校验节次与时间，这里仅防脏数据
      if (!range) {
        console.warn("课程缺少时间区间，已跳过：" + item.name)
        continue
      }
      const course = {
        name: item.name,
        position: this.prefixAtSymbol && item.position ? "@" + item.position : item.position || "",
        teacher: this.hideTeacher ? "" : item.teacher || "",
        timeText: minutesToText(range.start) + "-" + minutesToText(range.end),
        // 详情页与排序、分组都用这份区间，不再反解析文本
        range: range,
        isOngoing: false,
        progressPercent: 0
      }
      applyTimeState(course, minutes, isToday)
      target.push(course)
    }

    target.sort((a, b) => a.range.start - b.range.start)
    this.displayCourses = target
    this.hasCourses = target.length > 0

    // 课程分组：仅按结束时间分组
    const groups = [
      {title: "上午", courses: []},
      {title: "中午", courses: []},
      {title: "下午", courses: []},
      {title: "晚上", courses: []}
    ]
    for (let i = 0; i < target.length; i += 1) {
      const end = target[i].range.end
      if (end < 12 * 60) {
        groups[0].courses.push(target[i])
      } else if (end <= 14 * 60) {
        groups[1].courses.push(target[i])
      } else if (end <= 19 * 60) {
        groups[2].courses.push(target[i])
      } else {
        groups[3].courses.push(target[i])
      }
    }
    this.courseGroups = groups
  },

  openCourseDetail(course) {
    // 跳转课程详情页时，传递当天全部课程
    router.push({
      uri: "/pages/detail",
      params: {
        course: course,
        todayCourses: JSON.stringify(this.displayCourses)
      }
    })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #000000;
  align-items: center;
}

.pill-time {
  position: absolute;
  top: 4px;
  font-size: 24px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
  display: flex;
}

.rect-time {
  display: none;
}

.header-wrap {
  flex-direction: column;
  width: 100%;
  padding: 32px 0 6px;
  align-items: center;
  justify-content: center;
}

.week-text {
  color: #ffffff;
  font-size: 26px;
  font-weight: 800;
}

.date-switch-row {
  flex-direction: row;
  width: 100%;
  align-items: center;
  justify-content: center;
}

.date-arrow-button {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background-color: transparent;
  align-items: center;
  justify-content: center;
}

.date-arrow-icon {
  width: 22px;
  height: 22px;
}

.date-center-wrap {
  width: 36%;
  align-items: center;
  justify-content: center;
}

.date-row {
  flex-direction: column;
  margin-top: 2px;
  align-items: center;
  justify-content: center;
}

.day-text,
.date-text {
  color: #ffffff;
  font-size: 22px;
  font-weight: 700;
}

.course-content {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

.course-list-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
  padding: 10px;
}

.section-title {
  color: #ffffff;
  font-size: 28px;
  font-weight: 700;
  padding-bottom: 8px;
}

.course-row {
  flex-direction: column;
  width: 100%;
  margin-bottom: 10px;
}

.course-card {
  flex-direction: column;
  width: 100%;
  padding: 14px;
  border-radius: 20px;
  border-width: 2px;
  border-color: #3b3b3b;
  background-color: #090909;
}

.course-card-centered {
  align-items: center;
}

.course-name {
  color: #ffffff;
  font-size: 26px;
  font-weight: 700;
}

.course-meta {
  margin-top: 4px;
  color: #dedddd;
  font-size: 22px;
  font-weight: 700;
}

.text-centered {
  text-align: center;
}

.course-progress {
  width: 100%;
  margin-top: 10px;
  stroke-width: 8px;
  color: #ffffff;
  layer-color: rgba(255, 255, 255, 0.3);
}

.state-wrap {
  flex: 1;
  width: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 40px;
}

.empty-icon {
  width: 72px;
  height: 72px;
  margin-bottom: 14px;
}

.empty-text {
  color: #ffffff;
  font-size: 28px;
  font-weight: 700;
  text-align: center;
}

.settings-button {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 20px;
  z-index: 10;
  width: 58%;
  height: 64px;
  border-radius: 30px;
  border-width: 2px;
  border-color: #3b3b3b;
  background-color: #111111;
  align-items: center;
  justify-content: center;
}

.settings-icon {
  width: 40px;
  height: 40px;
}

@media (shape: rect) {
  .pill-time {
    display: none;
  }

  .rect-time {
    display: flex;
    margin-left: 12px;
    color: #ffffff;
    font-size: 30px;
    font-weight: 800;
  }

  .header-wrap {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    padding: 18px 0 6px;
  }

  .date-switch-row {
    width: 100%;
  }

  .week-text {
    font-size: 30px;
  }

  .date-row {
    flex-direction: row;
  }

  .date-center-wrap {
    width: 46%;
  }

  .date-text {
    margin-left: 10px;
  }

  .date-arrow-icon {
    width: 26px;
    height: 26px;
  }

  .day-text,
  .date-text {
    font-size: 26px;
  }

  .date-arrow-button {
    width: 54px;
    height: 54px;
  }

  .empty-icon {
    width: 82px;
    height: 82px;
  }

  .empty-text {
    font-size: 32px;
  }

  .section-title {
    font-size: 30px;
  }

  .course-name {
    font-size: 28px;
  }

  .course-meta {
    font-size: 24px;
  }

  .settings-button {
    width: 40%;
  }
}
</style>
