{
  "name": "hyperschedule-for-band",
  "version": "1.0.0",
  "private": true,
  "description": "HyperSchedule 手环端快应用",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "aiot start --watch",
    "build": "aiot build",
    "release": "aiot release",
    "lint": "eslint --format codeframe --fix --ext .ux,.js src/",
    "lint:style": "stylelint \"src/**/*.ux\"",
    "format": "prettier --write \"src/**/*.ux\" \"src/**/*.json\" \"src/**/*.js\"",
    "check": "prettier --check \"src/**/*.ux\" \"src/**/*.json\" \"src/**/*.js\" && npm run lint:style"
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.8",
    "aiot-toolkit": "^2.0.5",
    "eslint": "^8.57.1",
    "eslint-formatter-codeframe": "^7.32.2",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
